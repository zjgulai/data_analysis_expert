{
  "schema_version": "1.0.0",
  "document_id": "book-ontology-ai-data-management-2026",
  "domain_id": "ontology-ai-data-management-draft",
  "evidence_level": "published-book-derived-candidate",
  "terms": [
    {"term_key":"oadm:term:ontology","preferred_label":"本体","aliases":["Ontology"],"definition":"作者所述的形式化、结构化业务意义框架，用于显式组织概念、关系、规则和行动，使知识可被人理解并被机器计算。","section_ids":["4.1.1"],"not_equivalent_to":["知识图谱","实体模型"]},
    {"term_key":"oadm:term:business-ontology","preferred_label":"业务本体","aliases":["企业业务本体"],"definition":"围绕具体业务任务或决策组织事实、事理与行动，并供 AI Agent 理解、推理和执行的本体模型。","section_ids":["4.1.2","5.1.3"],"not_equivalent_to":["AI 业务数据"]},
    {"term_key":"oadm:term:fact","preferred_label":"事实","aliases":["业务事实"],"definition":"对业务对象、关系、事件和当前状态的可追溯描述，回答发生了什么或当前是什么。","section_ids":["4.1.2","5.3.1"],"not_equivalent_to":["事理","推理结果"]},
    {"term_key":"oadm:term:mechanism","preferred_label":"事理","aliases":["业务事理","事理逻辑"],"definition":"对业务规则、原因、约束、流程和决策机制的表达，回答为什么以及应如何运作。","section_ids":["4.1.2","5.3.2"],"not_equivalent_to":["事实","行动"]},
    {"term_key":"oadm:term:action","preferred_label":"行动","aliases":["业务行动","Action"],"definition":"由目标、前置条件、输入输出、执行效果和反馈约束的可实施业务动作。","section_ids":["4.1.2","5.4.5","5.5.3"],"not_equivalent_to":["自然语言建议"]},
    {"term_key":"oadm:term:semantic-interconnection","preferred_label":"语义互联","aliases":["语义互操作"],"definition":"不同系统、组织或数据来源在交换数据时保持概念含义和解释一致的能力。","section_ids":["4.1.3"],"not_equivalent_to":["物理连接","语义推理"]},
    {"term_key":"oadm:term:semantic-reasoning","preferred_label":"语义推理","aliases":["本体语义推理"],"definition":"基于形式化概念、属性约束和逻辑规则推导结论，并为 AI 提供业务常识与行为边界的能力。","section_ids":["4.1.3"],"not_equivalent_to":["向量相似检索","语义互联"]},
    {"term_key":"oadm:term:symbolic-ai","preferred_label":"符号主义","aliases":["Symbolic AI"],"definition":"以符号、概念和规则表达知识并进行可解释确定性推理的智能路线。","section_ids":["4.1.4"],"not_equivalent_to":["联结主义"]},
    {"term_key":"oadm:term:connectionism","preferred_label":"联结主义","aliases":["Connectionism"],"definition":"依靠神经网络和数据学习统计模式，擅长模式识别、概率推理和泛化的智能路线。","section_ids":["4.1.4"],"not_equivalent_to":["符号主义"]},
    {"term_key":"oadm:term:hybrid-intelligence","preferred_label":"混合智能","aliases":["符号主义+联结主义"],"definition":"以形式化规则和业务语义增强神经网络概率推理，使确定性边界与泛化能力协同的架构方向。","section_ids":["4.1.4","4.2.1"],"not_equivalent_to":["纯规则系统","纯概率模型"]},
    {"term_key":"oadm:term:ontology-semantic-layer","preferred_label":"本体语义层","aliases":["统一语义层"],"definition":"位于业务、信息、应用和技术架构之间，将业务共识转为机器可理解模型并提供统一语义调用的架构层。","section_ids":["4.4.1"],"not_equivalent_to":["API 网关","数据仓库"]},
    {"term_key":"oadm:term:entity-modeling","preferred_label":"实体建模","aliases":["ERD","实体关系建模"],"definition":"围绕实体、属性和值记录业务事实和结构，主要回答业务中有什么。","section_ids":["4.4.2"],"not_equivalent_to":["本体建模"]},
    {"term_key":"oadm:term:knowledge-graph","preferred_label":"知识图谱","aliases":["Knowledge Graph","KG"],"definition":"以实体及关系承载实例化知识的数据结构；在作者框架中，本体提供其语义骨架和推理规则。","section_ids":["4.4.3"],"not_equivalent_to":["本体","本体库"]},
    {"term_key":"oadm:term:ontology-repository","preferred_label":"本体库","aliases":["Ontology Repository"],"definition":"存储形式化概念、关系、规则和行动语义，面向 AI Agent 提供可推理业务逻辑的知识基础设施。","section_ids":["4.4.4"],"not_equivalent_to":["数据湖","文档知识库"]},
    {"term_key":"oadm:term:ai-data-asset","preferred_label":"AI 数据资产","aliases":["面向 AI 的数据资产"],"definition":"面向大模型训练与 AI Agent 推理组织的数据集、事实数据、事理模型和推理结果等可治理资产。","section_ids":["5.1.3"],"not_equivalent_to":["训练数据集"]},
    {"term_key":"oadm:term:ai-business-data","preferred_label":"AI 业务数据","aliases":[],"definition":"以 AI 任务或决策为管理锚点，但其事理尚未完成本体建模，可能以 Prompt 或文本方式表达的业务数据集合。","section_ids":["5.1.3"],"not_equivalent_to":["AI 业务本体"]},
    {"term_key":"oadm:term:ai-business-ontology","preferred_label":"AI 业务本体","aliases":[],"definition":"以具体 AI 任务或决策为管理锚点，已经把相关事理本体化并贯通事实、事理与行动的业务模型。","section_ids":["5.1.3"],"not_equivalent_to":["AI 业务数据"]},
    {"term_key":"oadm:term:ai-dataset","preferred_label":"AI 数据集","aliases":["AI Dataset"],"definition":"用于模型训练、验证、测试或知识表征，并作为责任、共享、风险和生命周期管理基本单元的数据集合。","section_ids":["5.2.1","5.2.2"],"not_equivalent_to":["全部 AI 数据资产"]},
    {"term_key":"oadm:term:fact-data","preferred_label":"事实数据","aliases":["推理态事实数据"],"definition":"与推理任务直接相关的结构化、非结构化或关系数据，用于还原业务当前状态并支撑精准判断。","section_ids":["5.3.1"],"not_equivalent_to":["事理模型","推理结果数据"]},
    {"term_key":"oadm:term:mechanism-model","preferred_label":"事理模型","aliases":["业务事理模型"],"definition":"将企业规则、决策逻辑、流程、权限和目标转为 AI 可理解结构化语义的推理逻辑载体。","section_ids":["5.3.2"],"not_equivalent_to":["事实数据","Prompt 文本"]},
    {"term_key":"oadm:term:ontology-semantic-model","preferred_label":"本体语义模型","aliases":[],"definition":"事理模型的一种具象化管理单元，基于形式化语义规范表达特定 AI 推理任务的业务逻辑。","section_ids":["5.3.2"],"not_equivalent_to":["所有事理表达形式"]},
    {"term_key":"oadm:term:inference-result-data","preferred_label":"推理结果数据","aliases":["AI 推理结果数据"],"definition":"每次 AI 推理任务产生的结果与过程日志，作为可关联任务、来源版本和评估的业务痕迹。","section_ids":["5.3.3"],"not_equivalent_to":["事实数据"]},
    {"term_key":"oadm:term:data-owner","preferred_label":"数据 Owner","aliases":["数据所有者"],"definition":"作者所述的业务数据端到端责任角色，负责数据体系、质量、底座服务、安全授权与定密等。","section_ids":["5.2.3"],"not_equivalent_to":["AI 数据集责任人"]},
    {"term_key":"oadm:term:dataset-steward","preferred_label":"AI 数据集责任人","aliases":["数据集提供方责任人"],"definition":"负责 AI 数据集采集、注册、质量、发布、更新、许可、安全和生命周期的供给责任角色。","section_ids":["5.2.3"],"not_equivalent_to":["数据 Owner","AI 数据集使用责任人"]},
    {"term_key":"oadm:term:dataset-use-owner","preferred_label":"AI 数据集使用责任人","aliases":["数据集消费方责任人"],"definition":"对 AI 数据集在许可范围内的安全、隐私、合规、质量和使用结束后的处置承担责任的消费角色。","section_ids":["5.2.3"],"not_equivalent_to":["AI 数据集责任人"]},
    {"term_key":"oadm:term:rdf","preferred_label":"RDF","aliases":["Resource Description Framework"],"definition":"作者映射为以主语、谓语、宾语三元组描述业务资源和事实关联的基础语义标准。","section_ids":["5.4.1"],"not_equivalent_to":["OWL","SPARQL"]},
    {"term_key":"oadm:term:owl","preferred_label":"OWL","aliases":["Web Ontology Language"],"definition":"作者映射为表达类层级、属性约束、等价和基数等逻辑语义的本体语言。","section_ids":["5.4.2"],"not_equivalent_to":["RDF","SWRL"]},
    {"term_key":"oadm:term:skos","preferred_label":"SKOS","aliases":["Simple Knowledge Organization System"],"definition":"作者映射为统一术语定义、分类和关联，建立受控词表与语义共识的标准。","section_ids":["5.4.3"],"not_equivalent_to":["OWL"]},
    {"term_key":"oadm:term:swrl","preferred_label":"SWRL","aliases":["Semantic Web Rule Language"],"definition":"作者映射为以如果—那么规则组合事实与约束并推导结论的规则语言。","section_ids":["5.4.4"],"not_equivalent_to":["OWL"]},
    {"term_key":"oadm:term:owl-s","preferred_label":"OWL-S","aliases":["Web Ontology Language for Services"],"definition":"作者映射为用输入、输出、前置条件和效果描述服务、流程活动与行动原语的语义规范。","section_ids":["5.4.5"],"not_equivalent_to":["BPMN","OWL"]},
    {"term_key":"oadm:term:odrl","preferred_label":"ODRL","aliases":["Open Digital Rights Language"],"definition":"作者映射为表达许可、禁止、义务、资产和使用约束的权限与策略语言。","section_ids":["5.4.6"],"not_equivalent_to":["身份认证系统"]},
    {"term_key":"oadm:term:sparql","preferred_label":"SPARQL","aliases":["SPARQL Protocol and RDF Query Language"],"definition":"作者映射为查询和操作 RDF 图数据、支持 Agent 按意图取用本体数据的接口语言。","section_ids":["5.4.7"],"not_equivalent_to":["RDF"]},
    {"term_key":"oadm:term:goal-evaluation","preferred_label":"目标与评估","aliases":["目标评估规范"],"definition":"7+1 中用于明确 AI 任务、业务效果、质控标准和所依赖事理的结构化维度。","section_ids":["5.4.8"],"not_equivalent_to":["单一模型指标"]}
  ]
}
