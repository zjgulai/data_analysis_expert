  "terms":[
    {"term_key":"oadm:term:intent-ontology-alignment","preferred_label":"意图与本体对齐","aliases":["意图本体映射"],"definition":"将 Agent 任务语义与本体中相关概念、规则和知识边界建立映射的调用前置过程。","section_ids":["7.1.2"],"not_equivalent_to":["本体检索"]},
    {"term_key":"oadm:term:minimal-necessary-ontology","preferred_label":"最小必要本体","aliases":["最小本体片段"],"definition":"仅包含当前任务决策必需概念、关系、规则与约束的按需加载本体子集。","section_ids":["7.1.3"],"not_equivalent_to":["完整本体库"]},
    {"term_key":"oadm:term:graph-vector-retrieval","preferred_label":"图向量库检索","aliases":["本体向量检索"],"definition":"将本体节点或子图编码为向量并按语义相似度召回候选知识的检索方式。","section_ids":["7.1.3"],"not_equivalent_to":["图数据库精确查询"]},
    {"term_key":"oadm:term:memory-augmented-ontology-call","preferred_label":"记忆增强调用","aliases":["本体记忆调用"],"definition":"结合 Agent 短期上下文与长期成功模式动态筛选本体片段的调用方式。","section_ids":["7.1.3"],"not_equivalent_to":["静态映射"]},
    {"term_key":"oadm:term:ontology-skill","preferred_label":"本体 Skill","aliases":["本体技能封装"],"definition":"包含功能、输入输出和本体逻辑，可被 Agent 规划与渐进调用的模块化知识单元。","section_ids":["7.1.3"],"not_equivalent_to":["普通提示词"]},
    {"term_key":"oadm:term:ontology-embedding","preferred_label":"本体嵌入","aliases":["本体模型嵌入"],"definition":"将符号化本体逻辑转译为模型可理解和遵循的业务上下文或训练信号。","section_ids":["7.1.4"],"not_equivalent_to":["向量嵌入"]},
    {"term_key":"oadm:term:constraint-strength","preferred_label":"本体约束强度","aliases":["规则约束等级"],"definition":"按场景风险配置规则对 Agent 推理自主空间限制程度的强、中、弱等级概念。","section_ids":["7.2.2"],"not_equivalent_to":["模型置信度"]},
    {"term_key":"oadm:term:execution-event-bus","preferred_label":"执行事件总线","aliases":["多 Agent 执行总线"],"definition":"由本体定义任务、状态和异常语义，用于主子 Agent 传递指令与反馈的交互通道。","section_ids":["7.3.3"],"not_equivalent_to":["消息队列产品"]},
    {"term_key":"oadm:term:dynamic-fact-association","preferred_label":"动态事实关联","aliases":["动态事实关联机制"],"definition":"通过摄取、语义映射和关系构建把多源数据持续转成可查询语义事实网络的机制。","section_ids":["7.4.1"],"not_equivalent_to":["一次性数据导入"]},
    {"term_key":"oadm:term:dynamic-action-association","preferred_label":"动态 Action 关联","aliases":["动态行动关联"],"definition":"把决策结果转为受协议、参数、安全校验和反馈约束的可执行数字动作机制。","section_ids":["7.4.2"],"not_equivalent_to":["自由文本建议"]},
    {"term_key":"oadm:term:ontology-as-a-service","preferred_label":"本体即服务","aliases":["Ontology as a Service"],"definition":"通过标准接口按意图提供可版本化、可授权、可组合本体片段的运行时服务理念。","section_ids":["7.4.3"],"not_equivalent_to":["静态本体文件"]},
    {"term_key":"oadm:term:semantic-middleware","preferred_label":"语义中间件","aliases":["统一语义中间件"],"definition":"在平台模块之间统一解析、转换、传递和查询本体知识的集成枢纽。","section_ids":["7.5.5"],"not_equivalent_to":["通用 API 网关"]},
    {"term_key":"oadm:term:penetration-validation","preferred_label":"穿刺式验证","aliases":["快速穿刺验证"],"definition":"以轻量本体、极简 Agent、真实小样本和量化结果快速检验技术链路可行性的作者策略。","section_ids":["8.3.1"],"not_equivalent_to":["规模化生产验收"]},
    {"term_key":"oadm:term:one-plus-four-organization","preferred_label":"1+4 组织协同","aliases":["总体组加四专业小队"],"definition":"总体组统筹本体认知、数据感知、Agent 决策和行动执行四类专业小队的作者组织模式。","section_ids":["8.3.2"],"not_equivalent_to":["固定组织架构标准"]},
    {"term_key":"oadm:term:ai-translation","preferred_label":"AI 转译","aliases":["知识资产 AI 转译"],"definition":"由 AI 将半结构化业务知识初步转换为机器可读本体，再经专家校验和数据连接的过程。","section_ids":["8.3.3"],"not_equivalent_to":["自动认证知识"]},
    {"term_key":"oadm:term:multi-agent-pdca","preferred_label":"多 Agent PDCA","aliases":["多场景 PDCA 自闭环"],"definition":"由统筹 Agent 与环节 Agent 按计划、执行、检查、处理协作运行的闭环模式。","section_ids":["8.2.6"],"not_equivalent_to":["单 Agent 工作流"]}
